# Copy to .env and fill in. .env is git-ignored and holds a live credential.
#
#   cp .env.example .env
#
# Every one of these is read through jarvis.config.load_settings(). Nothing in the
# package hardcodes a model, a URL, a key, a scope, or a limit -- if you cannot set
# it here, it is a constant in the source and that is the bug.

# ---------------------------------------------------------------- the LLM
# The answer-composition and orchestration model. Any OpenAI-compatible endpoint.
# Examples:
#   OpenAI:   LLM_BASE_URL = "https://api.openai.com/v1"
#   OpenRouter: LLM_BASE_URL = "https://openrouter.ai/api/v1"
#   Groq:    LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL    = "gpt-4o-mini"

# The planner and router model. Defaults to LLM_MODEL when unset. Point it at a
# local model (LM Studio, ollama, vllm) to keep routing and planning off the network.
# DSPY_MODEL=

# Comma-separated, tried in order when a call 429s or fails transiently.
# LLM_FALLBACK_MODELS = "gpt-4o-mini-2024-07-18,gpt-4o"

LLM_API_KEY  = "sk-replace-me"
LLM_TIMEOUT_S = 60
LLM_TEMPERATURE = 0.0
LLM_MAX_TOKENS = 1500

# ---------------------------------------------------------------- the jail
# The read scope. Comma-separated absolute paths. The DEFAULT is your home
# directory, which is broad; narrow it if you want.
# JARVIS_READ_ROOT = "/home/you/projects"

# Where a writer would go. Nothing writes here while the executor is tier 0.
WRITE_WORKSPACE = "~/jarvis_workspace"

# ---------------------------------------------------------------- the executor
# 0 = read-only commands only. 1 adds workspace writes. 2 adds interpreters and
# network. Raising this is the single most consequential line in this file.
EXECUTOR_ENABLED_TIER = 0

# Refuse anything that is not provably read-only, even at tier 0. Leave this on
# until you have read the probe output.
EXECUTOR_DRY_RUN = 1

# Per-agent command budget and timeout, for the executor.
EXECUTOR_MAX_CALLS = 12
EXECUTOR_TIMEOUT_S = 30

# ---------------------------------------------------------------- budgets
# A model-driven loop is unbounded by construction, so these are not optional.
JARVIS_MAX_LLM_CALLS  = 12
JARVIS_MAX_TOOL_CALLS = 40
# The react loop's turn count is min(12, this), so this is the real ceiling.
JARVIS_MAX_ITERATIONS = 8
JARVIS_MAX_TOKENS     = 200000
JARVIS_WALL_CLOCK_S   = 300
JARVIS_MAX_REPLANS    = 2

# ---------------------------------------------------------------- limits
# grep_max_results, grep_max_per_file, read_max_bytes, read_max_lines,
# exec_max_output_bytes, timeout_s, address_space_bytes, file_size_bytes...
# Every field of jarvis.config.Limits is settable as LIMIT_<FIELD_UPPER>.
# LIMIT_EXEC_MAX_OUTPUT_BYTES = 20000

# ---------------------------------------------------------------- behaviour
# Use ripgrep when it is installed. It is not, on this machine, and the probe
# reports those cases as INCONCLUSIVE rather than as passes.
USE_RG = 0

# Where the metadata index lives. Outside the read scope on purpose, so an agent
# cannot read the database directly and bypass the query tool's limits.
# JARVIS_INDEX_DIR = "~/.local/share/jarvis"